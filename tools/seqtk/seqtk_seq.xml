<tool id="seqtk_seq_rc" name="seqtk seq -r" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="23.0">
    <description>reverse-complement sequences</description>
    <macros>
        <token name="@TOOL_VERSION@">1.5</token>
        <token name="@VERSION_SUFFIX@">0</token>
    </macros>
    <xrefs>
        <xref type="bio.tools">seqtk</xref>
    </xrefs>
    <requirements>
        <requirement type="package" version="1.5">seqtk</requirement>
    </requirements>
    <command detect_errors="aggressive"><![CDATA[seqtk seq -r '$input' > '$output']]></command>
    <inputs>
        <param name="input" type="data" format="fasta" label="Sequences"/>
    </inputs>
    <outputs>
        <data name="output" format="fasta"/>
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <param name="input" value="in.fa"/>
            <output name="output" file="out.fa"/>
        </test>
    </tests>
    <help format="markdown"><![CDATA[
Reverse-complements each sequence in a FASTA file with ``seqtk seq -r``.

**Input**: a FASTA file of sequences.

**Output**: a FASTA file where every sequence has been reverse-complemented (sequence names are preserved).
    ]]></help>
    <citations>
        <citation type="bibtex">@misc{seqtk, title={seqtk}, url={https://github.com/lh3/seqtk}}</citation>
    </citations>
</tool>
